{
  "name": "kore",
  "private": true,
  "version": "0.3.16",
  "type": "module",
  "description": "Kore · 极速本地 Markdown 编辑器（开源 / 无云同步）",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "vite",
    "predev:desktop": "node scripts/check-node.mjs",
    "dev:desktop": "tauri dev",
    "prebuild": "node scripts/check-node.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/lint": "^6.8.2",
    "@codemirror/search": "^6.5.7",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.3",
    "codemirror": "^6.0.1",
    "dompurify": "^3.1.7",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.451.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.21.5",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5"
  }
