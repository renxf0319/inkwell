{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kore",
  "version": "0.3.16",
  "identifier": "com.kore.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kore",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQzRCN0JDQzE4RTRGREIKUldUYlQ0N0J2TGZFajlESHpnZWJMUXhwaXh0bHFYSzlwU0wzU3RhVTQ3dEd1SmpQbUdKWGhBVk0K",
      "endpoints": [
        "https://github.com/renxf0319/kore/releases/latest/download/latest.json"
      ]
    }
  }
}
